{
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Optimized",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/../MTSManager/build/MTS2D",
            "args": [
                "-c",
                "${workspaceFolder}/../MTSManager/examples/smoke.conf",
                "-o",
                "${workspaceFolder}/test_data/vscode"
            ],
            "cwd": "${workspaceFolder}",
            "initCommands": [
                "command script import ${workspaceFolder}/libs/eigen/debug/lldb/eigenlldb.py",
                "type summary add -F lldb_formatters.valarray_summary VArray"
            ],
            "preLaunchTask": "build-release"
        },
        {
            "name": "Debug gdb (linux)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/MTS2D",
            "args": [
                "-c",
                "${workspaceFolder}/../MTSManager/examples/smoke.conf",
                "-o",
                "${workspaceFolder}/test_data/vscode"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build and test"
        },
        {
            "name": "Debug lldb (mac)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/MTS2D",
            "args": [
                "-c",
                "${workspaceFolder}/../MTSManager/examples/smoke.conf",
                "-o",
                "${workspaceFolder}/test_data/vscode"
            ],
            "cwd": "${workspaceFolder}/build",
            "initCommands": [
                "command script import ${workspaceFolder}/libs/eigen/debug/lldb/eigenlldb.py",
                "type summary add -F lldb_formatters.valarray_summary VArray"
            ],
            "preLaunchTask": "build and test"
        },
        {
            "name": "Debug lldb (mac) CustomCommand",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/MTS2D",
            "args": [
                "-c /Volumes/data/MTS2D_output/fastsimpleShear,s12x12l0.2,0.001,1.0PBCedgeFlipt1epsR1e-05LBFGSEpsx1e-06logDuringMinimization1energyDropThreshold1e-10s0/config.conf"
            ],
            "cwd": "${workspaceFolder}/build",
            "initCommands": [
                "command script import ${workspaceFolder}/libs/eigen/debug/lldb/eigenlldb.py",
                "type summary add -F lldb_formatters.valarray_summary VArray"
            ],
            "preLaunchTask": "build and test"
        },
        {
            "name": "Debug loading lldb (mac)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/MTS2D",
            "args": [
                "-d /Volumes/data/MTS2D_output/simpleShear,s150x150l0.138,5e-06,1.0PBCedgeFlipt8initialGuessNoise0.04LBFGSEpsx1e-05s0/dumps/dump_l0.60.xml",
                "-r"
            ],
            "cwd": "${workspaceFolder}/build",
            "initCommands": [
                "command script import ${workspaceFolder}/libs/eigen/debug/lldb/eigenlldb.py",
                "type summary add -F lldb_formatters.valarray_summary VArray"
            ],
            "preLaunchTask": "build and test"
        },
        {
            "name": "Debug test",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/test_MTS2D",
            "cwd": "${workspaceFolder}/build",
            "initCommands": [
                "command script import ${workspaceFolder}/libs/eigen/debug/lldb/eigenlldb.py",
                "type summary add -F lldb_formatters.valarray_summary VArray"
            ],
            "preLaunchTask": "build"
        }
    ],
    "version": "2.0.0"
}
