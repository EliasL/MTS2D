{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "configure debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ]
        },
        {
            "label": "build",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--parallel",
                "2"
            ],
            "dependsOn": "configure debug",
            "group": "build"
        },
        {
            "label": "test",
            "type": "process",
            "command": "${workspaceFolder}/build/test_MTS2D",
            "dependsOn": "build"
        },
        {
            "label": "build and test",
            "dependsOn": "test"
        },
        {
            "label": "build-release",
            "type": "process",
            "command": "${workspaceFolder}/../.venv/bin/python",
            "args": [
                "-m",
                "MTS_Management",
                "--sites",
                "${workspaceFolder}/../MTSManager/sites.toml",
                "build",
                "--site",
                "local"
            ]
        },
        {
            "label": "plot benchmark",
            "type": "process",
            "command": "${workspaceFolder}/../.venv/bin/python",
            "args": [
                "${workspaceFolder}/../MTSPlot/examples/benchmark_figures.py"
            ],
            "options": {
                "env": {
                    "MPLBACKEND": "Agg"
                }
            }
        }
    ]
}
