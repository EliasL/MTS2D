{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "configure debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "build",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/debug",
                "--parallel",
                "2"
            ],
            "dependsOn": "configure debug"
        },
        {
            "label": "test",
            "type": "process",
            "command": "${workspaceFolder}/build/debug/test_MTS2D",
            "dependsOn": "build"
        },
        {
            "label": "build and test",
            "dependsOn": "test"
        },
        {
            "label": "build-release",
            "type": "process",
            "command": "${workspaceFolder}/../.venv/bin/python",
            "args": [
                "-m",
                "MTS_Management",
                "--sites",
                "${workspaceFolder}/../MTSManager/sites.toml",
                "build",
                "--site",
                "local"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}/.."
            }
        },
        {
            "label": "plot benchmark",
            "type": "process",
            "command": "${workspaceFolder}/../.venv/bin/python",
            "args": [
                "${workspaceFolder}/../MTSPlot/examples/benchmark_figures.py"
            ],
            "options": {
                "env": {
                    "MPLBACKEND": "Agg"
                }
            }
        }
    ]
}
